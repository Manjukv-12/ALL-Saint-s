# Formspree form ID for the Contact page "Send Us a Message" form.
# 1. Sign up at https://formspree.io and create a new form.
# 2. Set the notification email to your church email (e.g. allsaintscsichurchtcr2020@gmail.com).
# 3. Copy your form ID from the form endpoint (e.g. xpwnqkab from https://formspree.io/f/xpwnqkab).
# 4. Copy this file to .env and set the value:
VITE_FORMSPREE_ID=

# Choir registration API (PHP backend)
# `npm run dev` also loads .env.development (committed) → local PHP by default.
# Local PHP: keep VITE_API_URL pointed at 127.0.0.1:8080 so Vite knows the proxy target; api.ts uses same-origin
# /api in dev (no CORS). VITE_API_LOCAL_PROXY_TARGET must match `php -S` listen address.
# Local dev: from ALL-Saint-s folder run `npm start` (API + website) or `npm run api:php` in one terminal and `npm run dev` in another.
# If choir multipart fails via proxy only, add to .env.local: VITE_API_USE_DIRECT_LOCAL=1 (then browser calls
# :8080 directly — you need CORS on PHP or use Hostinger URL below).
# To hit Hostinger from dev instead: VITE_API_URL=https://csiallsaintstcr.com/backend-php
# Or run: npm run dev:live-api  (loads .env.developmentlive — same members as https://csiallsaintstcr.com)
VITE_API_URL=http://127.0.0.1:8080
VITE_API_LOCAL_PROXY_TARGET=http://127.0.0.1:8080
# Optional: Vite dev port (default 5173)
# VITE_DEV_PORT=5173
# Production: https://csiallsaintstcr.com/backend-php (use .env.production for builds)
# Full URLs in Google Sheets exports (must be public HTTPS; not localhost):
# VITE_EXPORT_FILES_BASE=https://csiallsaintstcr.com/backend-php

# Optional: admin API key for the choir registrations dashboard (GET /api/choir-registrations).
# If set, the dashboard can fetch without asking for the key each time.
# If the key contains #, quote the value: VITE_ADMIN_API_KEY="All@Saints#2026"
VITE_ADMIN_API_KEY=

# Church management uses the same VITE_API_URL / PHP backend as the rest of the site.
# One-time local setup: npm run setup:church-mgmt
# See docs/SETUP-CHURCH-MGMT.md for full local + production steps.

# Staff hub (no password): open #/admin for links to choir list and events admin.
